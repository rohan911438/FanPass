PORT=4000
NODE_ENV=development
WEB_ORIGIN=http://localhost:3000
# Must be this API's real public URL in production (e.g. https://fanpass-api.up.railway.app) —
# used to build ticket image URLs. Only safe to leave unset for local dev.
API_PUBLIC_URL=http://localhost:4000

# No database setup needed — apps/api/data/ (JSON documents + uploaded files) is created
# automatically on first run. See src/config/localStore.ts.

# Injective EVM Testnet — contract addresses default to packages/shared/src/contracts/addresses.ts,
# override only if redeployed. TRUST_ENGINE_SIGNER_PRIVATE_KEY must hold VERIFIER_ROLE +
# VENUE_VERIFIER_ROLE on-chain — see docs/PHASE_4_BLOCKCHAIN_ARCHITECTURE.md.
INJECTIVE_EVM_TESTNET_RPC=https://k8s.testnet.json-rpc.injective.network/
TRUST_ENGINE_SIGNER_PRIVATE_KEY=
OWNERSHIP_REGISTRY_ADDRESS=
ESCROW_MARKETPLACE_ADDRESS=
ATTENDANCE_REGISTRY_ADDRESS=
USDC_ADDRESS=

# Phase 5 — x402 premium verification APIs. Just a receiving address; the backend only verifies
# incoming USDC transfers here, never sends from it, so no private key is needed.
X402_PAYMENT_RECEIVER_ADDRESS=
